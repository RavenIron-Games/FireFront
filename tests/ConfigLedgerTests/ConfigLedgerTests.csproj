<Project Sdk="Microsoft.NET.Sdk">
  <!-- Off-game harness for the PURE half of the config migration. Compiles the mod's real
       Config/ConfigLedger.cs on plain .NET - no BepInEx, no Unity, no Valheim - so the
       decisions that fail silently (a default that should have moved and did not, an admin
       value that should have been kept and was not) are checkable in about a second:
       .\tools\run-tests.ps1 from the repo root. The mod's own csproj excludes tests\**. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>FireFront.Tests</RootNamespace>
    <AssemblyName>ConfigLedgerTests</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\Config\ConfigLedger.cs" Link="Config\ConfigLedger.cs" />
    <!-- The ENGINE half too, since 2026-09-18. It names BepInEx types, so Stubs.cs stands in for
         them - but leaving it out meant every engine-side rule in the mod with the most live
         migration rungs was unmeasured. -->
    <Compile Include="..\..\Config\ConfigMigration.cs" Link="Config\ConfigMigration.cs" />
    <!-- And the real config surface, so the harness can cross-check that every slot ConfigLedger
         names is a key this build actually binds. That join is a pair of bare strings written in
         two different files; a typo in either stamps the version and never migrates again. -->
    <Compile Include="..\..\Config\FireConfig.cs" Link="Config\FireConfig.cs" />
  </ItemGroup>
</Project>
